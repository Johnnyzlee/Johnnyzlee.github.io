~~~
{}{raw}
<div class="command-item">
<p><span class="command-label"><span class="command-key">⌘</span>Exa usage for lzengan</span> &ndash; shows this month's Exa spend, search count, and content-read count in an inline Raycast row, refreshed hourly. Usage is summed across all team API keys; the key comes from macOS Keychain.</p>
<div class="copy-block">
<details>
<summary><span class="copy-block-marker">▸</span><span class="copy-block-title">Script (bash)</span><button type="button" class="copy-btn" data-copy="copy-exa-billing" aria-label="Copy to clipboard"><svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path></svg></button></summary>
<pre id="copy-exa-billing">#!/bin/bash

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Exa usage for lzengan
# @raycast.mode inline

# Optional parameters:
# @raycast.icon 🔎
# @raycast.packageName Exa
# @raycast.description 查询 Exa 本月消费和调用次数
# @raycast.refreshTime 1h

account_name="$(/usr/bin/id -un)"

service_key="$(
  /usr/bin/security find-generic-password \
    -a "$account_name" \
    -s "Exa Service API Key" \
    -w 2>/dev/null
)"

if [ -z "$service_key" ]; then
  echo "未找到 Exa Service API Key"
  exit 1
fi

extract_json() {
  printf '%s' "$1" |
    /usr/bin/plutil -extract "$2" raw -o - -- - 2>/dev/null
}

keys_result="$(
  /usr/bin/curl \
    -sS \
    --connect-timeout 5 \
    --max-time 20 \
    -w $'\n%{http_code}' \
    -H "Accept: application/json" \
    -H "x-api-key: $service_key" \
    "https://admin-api.exa.ai/team-management/api-keys"
)"

keys_http_status="${keys_result##*$'\n'}"
keys_body="${keys_result%$'\n'*}"

if [ "$keys_http_status" != "200" ]; then
  echo "Exa 查询失败：无法读取 API Keys（HTTP $keys_http_status）"
  exit 1
fi

key_count="$(extract_json "$keys_body" "apiKeys")"

if ! [[ "$key_count" =~ ^[0-9]+$ ]]; then
  echo "Exa 查询失败：返回数据格式异常"
  exit 1
fi

if [ "$key_count" -eq 0 ]; then
  echo "Exa 本月已用：\$0.00 ｜ 搜索 0 次"
  exit 0
fi

month_start="$(/bin/date '+%Y-%m-01')"

total_cost_usd="0"
total_searches=0
total_contents=0
key_index=0

while [ "$key_index" -lt "$key_count" ]; do
  key_id="$(
    extract_json \
      "$keys_body" \
      "apiKeys.$key_index.id"
  )"

  if [ -z "$key_id" ]; then
    echo "Exa 查询失败：无法读取 API Key ID"
    exit 1
  fi

  usage_result="$(
    /usr/bin/curl \
      -sS \
      --connect-timeout 5 \
      --max-time 20 \
      -G \
      -w $'\n%{http_code}' \
      -H "Accept: application/json" \
      -H "x-api-key: $service_key" \
      --data-urlencode "start_date=$month_start" \
      "https://admin-api.exa.ai/team-management/api-keys/$key_id/usage"
  )"

  usage_http_status="${usage_result##*$'\n'}"
  usage_body="${usage_result%$'\n'*}"

  if [ "$usage_http_status" != "200" ]; then
    echo "Exa 查询失败：无法读取本月用量（HTTP $usage_http_status）"
    exit 1
  fi

  key_cost_usd="$(
    extract_json \
      "$usage_body" \
      "total_cost_usd"
  )"

  if [ -z "$key_cost_usd" ]; then
    key_cost_usd="0"
  fi

  total_cost_usd="$(
    /usr/bin/awk \
      -v current="$total_cost_usd" \
      -v addition="$key_cost_usd" \
      'BEGIN { printf "%.6f", current + addition }'
  )"

  breakdown_count="$(
    extract_json \
      "$usage_body" \
      "cost_breakdown"
  )"

  if [[ "$breakdown_count" =~ ^[0-9]+$ ]]; then
    breakdown_index=0

    while [ "$breakdown_index" -lt "$breakdown_count" ]; do
      price_name="$(
        extract_json \
          "$usage_body" \
          "cost_breakdown.$breakdown_index.price_name"
      )"

      quantity="$(
        extract_json \
          "$usage_body" \
          "cost_breakdown.$breakdown_index.quantity"
      )"

      if ! [[ "$quantity" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        quantity=0
      fi

      case "$price_name" in
        "Search")
          total_searches="$(
            /usr/bin/awk \
              -v current="$total_searches" \
              -v addition="$quantity" \
              'BEGIN { printf "%.0f", current + addition }'
          )"
          ;;

        Contents*)
          total_contents="$(
            /usr/bin/awk \
              -v current="$total_contents" \
              -v addition="$quantity" \
              'BEGIN { printf "%.0f", current + addition }'
          )"
          ;;
      esac

      breakdown_index=$((breakdown_index + 1))
    done
  fi

  key_index=$((key_index + 1))
done

formatted_cost_usd="$(
  /usr/bin/awk \
    -v spent="$total_cost_usd" \
    'BEGIN { printf "%.2f", spent }'
)"

if [ "$total_contents" -gt 0 ]; then
  printf \
    'Exa 本月已用：$%s ｜ 搜索 %s 次 ｜ 内容读取 %s 次\n' \
    "$formatted_cost_usd" \
    "$total_searches" \
    "$total_contents"
else
  printf \
    'Exa 本月已用：$%s ｜ 搜索 %s 次\n' \
    "$formatted_cost_usd" \
    "$total_searches"
fi</pre>
</details>
</div>
</div>
~~~

