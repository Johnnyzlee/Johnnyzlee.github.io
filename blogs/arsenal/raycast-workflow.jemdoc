{}{raw}
<script>
(function () {
  var checkSvg = '<svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"></path></svg>';
  var buttons = document.querySelectorAll('.copy-btn');
  Array.prototype.forEach.call(buttons, function (button) {
    var originalSvg = button.innerHTML;
    button.addEventListener('click', function (event) {
      event.stopPropagation();
      var target = document.getElementById(button.getAttribute('data-copy'));
      if (!target) {
        return;
      }
      var text = target.textContent;
      function reset() {
        button.innerHTML = originalSvg;
      }
      function copied() {
        button.innerHTML = checkSvg;
        setTimeout(reset, 1500);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(copied, copied);
      } else {
        var range = document.createRange();
        range.selectNodeContents(target);
        var selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
        try {
          document.execCommand('copy');
        } catch (error) {}
        selection.removeAllRanges();
        copied();
      }
    });
  });
})();
</script>
~~~
~~~
{}{raw}
<script>
(function () {
  var content = document.getElementById('layout-content');
  if (!content) {
    return;
  }

  var headings = Array.prototype.slice.call(
    content.querySelectorAll('h2, h3')
  );

  function sectionEnd(heading) {
    var node = heading.nextElementSibling;
    while (node) {
      var tag = node.tagName;
      if (tag === 'H2' || tag === 'H3') {
        return node;
      }
      node = node.nextElementSibling;
    }
    return null;
  }

  function toggleSection(button, heading) {
    var collapsed = button.classList.toggle('collapsed');
    button.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    var node = heading.nextElementSibling;
    var end = sectionEnd(heading);
    while (node && node !== end) {
      node.classList.toggle('blog-section-collapsed', collapsed);
      node = node.nextElementSibling;
    }
  }

  headings.forEach(function (heading) {
    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'section-toggle';
    button.setAttribute('aria-label', 'Toggle section');
    button.setAttribute('aria-expanded', 'true');
    button.textContent = '\u25be';
    button.addEventListener('click', function () {
      toggleSection(button, heading);
    });
    heading.appendChild(button);
  });

  var sidebar = document.querySelector('.blog-sidebar-nav');
  if (sidebar) {
    sidebar.addEventListener('click', function (event) {
      var link = event.target.closest
        ? event.target.closest('a[data-section-id]')
        : null;
      if (!link) {
        return;
      }
      var target = document.getElementById(link.getAttribute('data-section-id'));
      if (!target) {
        return;
      }
      headings.forEach(function (heading) {
        if (heading === target) {
          return;
        }
        var button = heading.querySelector('.section-toggle');
        if (!button || !button.classList.contains('collapsed')) {
          return;
        }
        if (
          target.compareDocumentPosition(heading) &
          Node.DOCUMENT_POSITION_FOLLOWING
        ) {
          toggleSection(button, heading);
        }
      });
    });
  }
})();
</script>
~~~
